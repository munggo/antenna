<?xml version="1.0" encoding="UTF-8"?>
<!-- 맥 브리지 서버 상시 실행용 launchd 에이전트.
     설치: sh deploy/install-agents.sh pi-remote (__ANTENNA_DIR__·__HOME__ 을 이 맥의 경로로 채워 ~/Library/LaunchAgents/ 에 두고 등록) -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.munggo.pi-remote</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__ANTENNA_DIR__/server/run.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/pi-remote.out</string>
	<key>StandardErrorPath</key>
	<string>/tmp/pi-remote.err</string>
	<key>WorkingDirectory</key>
	<string>__ANTENNA_DIR__/server</string>
</dict>
</plist>
