// 복사해서 Local.xcconfig 로 저장하고 자신의 값을 넣는다(Local.xcconfig 는 git 에 올라가지 않는다).

// Apple 개발 팀 번호(10글자). developer.apple.com → 멤버십 세부사항의 '팀 ID'
DEVELOPMENT_TEAM = XXXXXXXXXX

// 앱 식별자(번들 ID)의 앞부분. 자신만 쓰는 이름으로 바꾼다(예: 가진 도메인을 거꾸로 적은 것). 앱은 <앞부분>.piremote 가 된다.
// 폰 알림을 쓰면 맥 설정(~/.config/pi-remote/env)의 PI_REMOTE_APNS_TOPIC 도 같은 식별자(<앞부분>.piremote)로 맞춘다
BUNDLE_ID_PREFIX = com.example
